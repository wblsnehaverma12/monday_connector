    <!-- ======================================================================= -->
    <!-- MENUS CONFIGURATION                                                      -->
    <!-- ======================================================================= -->
    <!-- Root Menu -->
    <menuitem id="menu_monday_root" name="Monday Integration"
              web_icon="wbl_monday_connector,static/description/icon.png" action="action_monday_instance"
              sequence="60"/>

    <!-- Submenus -->
    <menuitem id="menu_monday_projects" name="Projects" parent="menu_monday_root"
              action="project.open_view_project_all" sequence="5"/>
    <menuitem id="menu_monday_tasks" name="Tasks" parent="menu_monday_root"
              action="project.action_view_all_task" sequence="6"/>
    <menuitem id="menu_monday_task_stages" name="Task Stages" parent="menu_monday_root"
              action="project.open_task_type_form" sequence="7"/>
    <menuitem id="menu_monday_configuration" name="Configuration" parent="menu_monday_root" sequence="10"/>
    <menuitem id="menu_monday_import_data" name="Import Monday Data" parent="menu_monday_root"
              action="action_monday_import_wizard" sequence="20"/>
    <menuitem id="menu_monday_logs" name="Sync Logs" parent="menu_monday_root" sequence="30"/>

    <!-- Configuration Submenus -->
    <menuitem id="menu_monday_config_boards" name="Monday Boards" parent="menu_monday_configuration"
              action="action_monday_board" sequence="10"/>
    <menuitem id="menu_monday_config_mappings" name="Field Mappings" parent="menu_monday_configuration"
              action="action_monday_mapping" sequence="20"/>


    <!-- Sync Logs Submenus -->
    <menuitem id="menu_monday_sync_history" name="Sync History" parent="menu_monday_logs"
              action="action_monday_sync_entry" sequence="10"/>
    <menuitem id="menu_monday_sync_queue" name="Queue" parent="menu_monday_logs" action="action_monday_queue_job"
              sequence="20"/>
</odoo>
