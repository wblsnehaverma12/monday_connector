<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================================= -->
    <!-- MONDAY INSTANCE VIEWS                                                    -->
    <!-- ======================================================================= -->
    <record id="view_monday_instance_tree" model="ir.ui.view">
        <field name="name">monday.instance.tree</field>
        <field name="model">monday.instance</field>
        <field name="arch" type="xml">
            <list string="Monday Accounts">
                <field name="name"/>
                <field name="monday_account_id"/>
                <field name="sync_interval"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'connected'"
                       decoration-danger="status == 'error'"
                       decoration-warning="status == 'draft'"/>
                <field name="last_sync"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_monday_instance_form" model="ir.ui.view">
        <field name="name">monday.instance.form</field>
        <field name="model">monday.instance</field>
        <field name="arch" type="xml">
            <form string="Monday Account">
                <header>
                    <button name="test_connection" string="Test Connection" type="object" class="btn-primary"
                            icon="fa-refresh"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,connected,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Production Monday Account"/>
                        </h1>
                    </div>
                    <group>
                        <group string="API Configuration">
                            <field name="api_token" password="True"/>
                            <field name="api_version"/>
                            <field name="base_url"/>
                            <field name="monday_account_id"/>
                        </group>
                        <group string="Integration Parameters">
                            <field name="sync_interval"/>
                            <field name="last_sync" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_monday_instance_kanban" model="ir.ui.view">
        <field name="name">monday.instance.kanban</field>
        <field name="model">monday.instance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="monday_account_id"/>
                <field name="status"/>
                <field name="sync_interval"/>
                <field name="last_sync"/>
                <field name="active"/>
                <field name="boards_count"/>
                <field name="users_count"/>
                <field name="items_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click overflow-hidden rounded-4 bg-white"
                             style="border:1px solid #E6E9EF;
                                    box-shadow:0 4px 12px rgba(0,0,0,.08);
                                    transition:all .25s ease;">

                            <!-- Header -->
                            <div class="p-3 text-white"
                                 style="background:linear-gradient(135deg,#FF3D57,#E2445C);">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div class="d-flex align-items-center">

                                        <div>

                                            <div class="fw-bold fs-4 text-truncate">
                                                <field name="name"/>
                                            </div>

                                            <div style="font-size:13px;opacity:.85;">
                                                Monday.com Workspace
                                            </div>

                                        </div>

                                    </div>

                                    <!-- Status -->

                                    <div>

                                        <span t-if="record.status.raw_value == 'connected'"
                                              class="fw-bold"
                                              style="color:#00FF9D;font-size:14px;">
                                            ● Connected
                                        </span>

                                        <span t-elif="record.status.raw_value == 'error'"
                                              class="fw-bold"
                                              style="color:#FF6B81;font-size:14px;">
                                            ● Error
                                        </span>

                                        <span t-else=""
                                              class="fw-bold"
                                              style="color:#FFC048;font-size:14px;">
                                            ● Draft
                                        </span>

                                    </div>

                                </div>

                            </div>

                            <!-- Body -->

                            <div class="p-3">

                                <!-- Info Cards -->

                                <div class="row g-3">

                                    <div class="col-6">

                                        <div class="text-muted small mb-1">
                                            Account ID
                                        </div>

                                        <div class="fw-bold text-dark fs-5">
                                            <field name="monday_account_id"/>
                                        </div>

                                    </div>

                                    <div class="col-6">

                                        <div class="text-muted small mb-1">
                                            Sync Every
                                        </div>

                                        <div class="fw-bold text-dark fs-5">
                                            <field name="sync_interval"/>
                                        </div>

                                    </div>

                                </div>

                                <hr style="border-top:1px solid #E6E9EF; margin:12px 0;"/>

                                <!-- Last Sync -->

                                <div>

                                    <div class="text-muted small mb-1">
                                        Last Sync
                                    </div>

                                    <div class="fw-semibold text-dark fs-6 d-flex align-items-center">

                                        <span class="text-success me-1 fw-bold">✓</span>

                                        <t t-if="record.last_sync.raw_value">
                                            <field name="last_sync"/>
                                        </t>
                                        <t t-else="">
                                            Never Synced
                                        </t>

                                    </div>

                                </div>

                                <hr style="border-top:1px solid #E6E9EF; margin:12px 0;"/>

                                <!-- Counts Section -->
                                <div class="row text-center g-2">

                                    <div class="col-4">

                                        <div class="p-2 rounded-3" style="background:#FFFDF0; border:1px solid #FFB300;">

                                            <div class="text-muted small" style="font-size: 11px;">
                                                Boards
                                            </div>

                                            <div class="fw-bold fs-5 mt-1" style="color:#C48400;">
                                                <field name="boards_count"/>
                                            </div>

                                        </div>

                                    </div>

                                    <div class="col-4">

                                        <div class="p-2 rounded-3" style="background:#FFFDF0; border:1px solid #FFB300;">

                                            <div class="text-muted small" style="font-size: 11px;">
                                                Users
                                            </div>

                                            <div class="fw-bold fs-5 mt-1" style="color:#C48400;">
                                                <field name="users_count"/>
                                            </div>

                                        </div>

                                    </div>

                                    <div class="col-4">

                                        <div class="p-2 rounded-3" style="background:#FFFDF0; border:1px solid #FFB300;">

                                            <div class="text-muted small" style="font-size: 11px;">
                                                Items
                                            </div>

                                            <div class="fw-bold fs-5 mt-1" style="color:#C48400;">
                                                <field name="items_count"/>
                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_monday_instance" model="ir.actions.act_window">
        <field name="name">Monday Accounts</field>
        <field name="res_model">monday.instance</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- ======================================================================= -->
    <!-- MONDAY BOARD VIEWS                                                       -->
    <!-- ======================================================================= -->
    <record id="view_monday_board_tree" model="ir.ui.view">
        <field name="name">monday.board.tree</field>
        <field name="model">monday.board</field>
        <field name="arch" type="xml">
            <list string="Monday Boards" create="false">
                <field name="name"/>
                <field name="monday_board_id"/>
                <field name="board_type"/>
                <field name="odoo_model_id"/>
                <field name="odoo_project_id"/>
            </list>
        </field>
    </record>

    <record id="view_monday_board_form" model="ir.ui.view">
        <field name="name">monday.board.form</field>
        <field name="model">monday.board</field>
        <field name="arch" type="xml">
            <form string="Monday Board" create="false">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="instance_id"/>
                            <field name="monday_board_id"/>
                            <field name="board_type"/>
                        </group>
                        <group>
                            <field name="odoo_model_id" options="{'no_create': True, 'no_edit': True}"/>
                            <field name="odoo_project_id" invisible="odoo_model_id != %(project.model_project_task)d"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Columns">
                            <field name="column_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="monday_column_id"/>
                                    <field name="column_type"/>
                                </list>
                            </field>
                        </page>
                        <page string="Groups">
                            <field name="group_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="monday_group_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_monday_board" model="ir.actions.act_window">
        <field name="name">Boards</field>
        <field name="res_model">monday.board</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ======================================================================= -->
    <!-- MONDAY MAPPING VIEWS                                                     -->
    <!-- ======================================================================= -->
    <record id="view_monday_mapping_tree" model="ir.ui.view">
        <field name="name">monday.mapping.tree</field>
        <field name="model">monday.mapping</field>
        <field name="arch" type="xml">
            <list string="Field Mappings" create="false">
                <field name="monday_board_id"/>
                <field name="odoo_model_id"/>
                <field name="odoo_field_id"/>
                <field name="monday_column_id"/>
                <field name="monday_column_type"/>
                <field name="direction"/>
            </list>
        </field>
    </record>

    <record id="view_monday_mapping_form" model="ir.ui.view">
        <field name="name">monday.mapping.form</field>
        <field name="model">monday.mapping</field>
        <field name="arch" type="xml">
            <form string="Field Mapping">
                <sheet>
                    <group>
                        <group string="Odoo Config">
                            <field name="odoo_model_id" options="{'no_create': True}"/>
                            <field name="odoo_model_name" invisible="1"/>
                            <field name="odoo_field_id" domain="[('model_id', '=', odoo_model_id)]"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Monday Config">
                            <field name="instance_id"/>
                            <field name="monday_board_id" domain="[('instance_id', '=', instance_id)]"/>
                            <field name="monday_column_id"/>
                            <field name="monday_column_type"/>
                        </group>
                    </group>
                    <group>
                        <group string="Sync Direction">
                            <field name="direction" widget="radio"/>
                            <field name="required"/>
                            <field name="default_value"/>
                        </group>
                        <group string="Transformation">
                            <field name="transform_function" placeholder="result = value.strip().upper()" widget="ace"
                                   xml:id="ace_transform"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_monday_mapping" model="ir.actions.act_window">
        <field name="name">Field Mappings</field>
        <field name="res_model">monday.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

