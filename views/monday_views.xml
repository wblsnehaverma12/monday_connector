    <!-- ======================================================================= -->
    <!-- MONDAY SYNC LOG VIEWS                                                   -->
    <!-- ======================================================================= -->
    <record id="view_monday_sync_log_tree" model="ir.ui.view">
        <field name="name">monday.sync.log.tree</field>
        <field name="model">monday.sync.log</field>
        <field name="arch" type="xml">
            <list string="Sync Logs" create="false" edit="false">
                <field name="create_date" string="Timestamp"/>
                <field name="name"/>
                <field name="direction" widget="badge"/>
                <field name="operation"/>
                <field name="duration" sum="Total Duration"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_monday_sync_log_form" model="ir.ui.view">
        <field name="name">monday.sync.log.form</field>
        <field name="model">monday.sync.log</field>
        <field name="arch" type="xml">
            <form string="Sync Log Details" create="false" edit="false">
                <header>
                    <button name="action_archive" string="Archive" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="instance_id"/>
                            <field name="direction"/>
                            <field name="operation"/>
                        </group>
                        <group>
                            <field name="duration"/>
                            <field name="status"/>
                            <field name="create_date" string="Logged At"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Error / Traceback" invisible="status == 'success'">
                            <group>
                                <field name="error_message" readonly="1"/>
                                <field name="traceback" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================================================================= -->
    <!-- MONDAY SYNC ENTRY VIEWS                                                 -->
    <!-- ======================================================================= -->
    <record id="view_monday_sync_entry_tree" model="ir.ui.view">
        <field name="name">monday.sync.entry.list</field>
        <field name="model">monday.sync.entry</field>
        <field name="arch" type="xml">
            <list string="Sync Entries" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="request_date" string="Request Date and Time"/>
                <field name="operation"/>
                <field name="import_action" string="Import Action"/>
                <field name="action_done" string="Action Done"/>
                <field name="instance_id" string="Account"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_monday_sync_entry_form" model="ir.ui.view">
        <field name="name">monday.sync.entry.form</field>
        <field name="model">monday.sync.entry</field>
        <field name="arch" type="xml">
            <form string="Sync Entry Details" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="request_date" readonly="1"/>
                            <field name="operation" readonly="1"/>
                        </group>
                        <group>
                            <field name="import_action" readonly="1"/>
                            <field name="action_done" readonly="1"/>
                            <field name="instance_id" readonly="1"/>
                            <field name="status" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_monday_sync_entry" model="ir.actions.act_window">
        <field name="name">Sync Entries</field>
        <field name="res_model">monday.sync.entry</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_monday_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">monday.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ======================================================================= -->
    <!-- MONDAY QUEUE JOB VIEWS                                                   -->
    <!-- ======================================================================= -->
    <record id="view_monday_queue_job_tree" model="ir.ui.view">
        <field name="name">monday.queue.job.tree</field>
        <field name="model">monday.queue.job</field>
        <field name="arch" type="xml">
            <list string="Queue Jobs" create="false">
                <field name="create_date" string="Enqueued At"/>
                <field name="name"/>
                <field name="model_name"/>
                <field name="record_id"/>
                <field name="operation"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'failed'"
                       decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_monday_queue_job_form" model="ir.ui.view">
        <field name="name">monday.queue.job.form</field>
        <field name="model">monday.queue.job</field>
        <field name="arch" type="xml">
            <form string="Queue Job Details" create="false">
                <header>
                    <button name="action_process_job" string="Force Process Now" type="object" class="btn-primary"
                            invisible="state in ['done']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,done,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="instance_id" readonly="1"/>
                            <field name="model_name" readonly="1"/>
                            <field name="record_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="operation" readonly="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload JSON">
                            <field name="payload" widget="ace" readonly="1"/>
                        </page>
                        <page string="Execution Error" invisible="state != 'failed'">
                            <group>
                                <field name="error_message" readonly="1"/>
                                <field name="traceback" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_monday_queue_job" model="ir.actions.act_window">
        <field name="name">Queue Jobs</field>
        <field name="res_model">monday.queue.job</field>
        <field name="view_mode">list,form</field>
    </record>

