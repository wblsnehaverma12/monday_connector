<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_monday" model="ir.module.category">
            <field name="name">Monday.com Connector</field>
            <field name="description">Access levels for Monday.com Connector.</field>
            <field name="sequence">100</field>
        </record>

        <record id="res_groups_privilege_monday" model="res.groups.privilege">
            <field name="name">Monday.com Access</field>
            <field name="category_id" ref="module_category_monday"/>
        </record>

        <record id="group_monday_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_monday"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_monday_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_monday"/>
            <field name="implied_ids" eval="[(4, ref('group_monday_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Automatically grant Manager access to Administrators -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_monday_manager'))]"/>
        </record>

        <record id="monday_instance_rule" model="ir.rule">
            <field name="name">Monday Instance Multi Company</field>
            <field name="model_id" ref="model_monday_instance"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="monday_board_rule" model="ir.rule">
            <field name="name">Monday Board Multi Company</field>
            <field name="model_id" ref="model_monday_board"/>
            <field name="domain_force">
                ['|', ('instance_id.company_id', '=', False), ('instance_id.company_id', 'in', company_ids)]
            </field>
        </record>
    </data>
</odoo>